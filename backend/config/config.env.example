NODE_ENV=production
PORT=3001

# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/fileforge

# Auth
JWT_SECRET=replace-with-strong-access-secret
REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Frontend origins (comma-separated)
FRONTEND_URLS=https://mpji-fileforge.vercel.app,http://localhost:5173
# Optional single-origin legacy key (keep empty if using FRONTEND_URLS)
FRONTEND_URL=

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Logging
LOG_LEVEL=info

# Worker / queue
CONCURRENCY=2

# Cleanup
CLEANUP_DAYS=7

# HTTPS (usually false on Render; TLS is terminated by the platform)
HTTPS=false
SSL_KEY_PATH=
SSL_CERT_PATH=
